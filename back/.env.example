EMAIL_USER=
EMAIL_PASS=

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# ── Sessão e URLs ──────────────────────────────────────────────────────────
SESSION_SECRET=
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:7070
# true quando o sistema estiver publicado em HTTPS
COOKIE_SECURE=false

# ── Senha Única USP (credenciais fornecidas pela STI) ─────────────────────
SENHAUNICA_KEY=
SENHAUNICA_SECRET=
SENHAUNICA_CALLBACK_ID=
# true = usa o ambiente de testes dev.uspdigital.usp.br
SENHAUNICA_DEV=true
# Vínculos USP que podem solicitar empréstimo
SENHAUNICA_VINCULOS=ALUNOGR,ALUNOPOS
# Código da unidade (opcional; vazio = qualquer unidade)
SENHAUNICA_CODIGO_UNIDADE=
# Números USP que sempre entram como admin (separados por vírgula)
SENHAUNICA_ADMINS=
# true = login simulado, sem a USP (NUNCA use em produção)
SENHAUNICA_FAKE=false
